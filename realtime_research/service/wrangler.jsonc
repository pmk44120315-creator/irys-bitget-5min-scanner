{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "irys-realtime-evidence",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "durable_objects": {"bindings": [{"name":"IRYS_RT", "class_name":"RealtimeEvidenceDO"}]},
  "migrations": [{"tag":"rt-v1", "new_sqlite_classes":["RealtimeEvidenceDO"]}],
  "triggers": {"crons":["* * * * *"]},
  "vars": {"ALLOW_TELEGRAM_TEST":"false", "ENABLE_ONCHAIN":"false", "KNOWN_WALLETS_JSON":"[]"}
}
